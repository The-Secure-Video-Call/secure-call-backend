# Copy to .env (never commit .env) and fill in the values marked "set". docker compose reads it,
# and passes it to the backend container.

# Where Nginx Proxy Manager reaches the backend. If the proxy runs on THIS Pi, keep
# 127.0.0.1. If it runs on another machine, set this Pi's home-network IP (hostname -I),
# ideally a fixed one (a DHCP reservation on your router).  set
BACKEND_PUBLISH_ADDR=127.0.0.1
# Never forward this port on your router.
BACKEND_PUBLISH_PORT=8001

# Backend
# set. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=signal.securevideocall.com
SIGNALING_ALLOWED_ORIGINS=https://securevideocall.com
# set. LAN IP of the machine running Nginx Proxy Manager (comma-separated IPs, no ranges).
# Only from these addresses is X-Forwarded-For believed (its rightmost entry), so rate limits
# count each visitor separately. The proxy must APPEND the visitor's address to the header
# (Nginx's $proxy_add_x_forwarded_for, the default) or overwrite it, never pass it on unchanged. Left empty, every visitor looks like the proxy and shares one
# limit. Must be set when this version is deployed, before TURN_URLS is set.
TRUSTED_PROXY_IPS=

# PostgreSQL. Run ./make-local-certs.sh once first: the database accepts TLS only.
POSTGRES_DB=securecall
# The superuser, for maintenance only; the backend never receives its password.
POSTGRES_USER=securecall
# set. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# The backend's own role: owns the database, nothing more. Created when the database is first
# created (an empty volume), so set these before the first start.
POSTGRES_APP_USER=securecall_app
# set. A different value from POSTGRES_PASSWORD, generated the same way.
POSTGRES_APP_PASSWORD=
# The backend reaches the database as "postgres" on the internal Docker network
# (set in compose.yaml). For database tools, it is also published on the Pi at:
#   127.0.0.1  = from the Pi only (connect from another computer through an SSH tunnel)
#   0.0.0.0    = from any device on your home network as well
# Never forward this port on your router.
POSTGRES_PUBLISH_ADDR=127.0.0.1
# 5432 and 5433 are already used on the Pi by other databases.
POSTGRES_PUBLISH_PORT=5434

# TURN (coturn). The same secret is later given to the backend (secure-call-backend#26).
# set. Generate one on the Pi with:  openssl rand -base64 32
TURN_SHARED_SECRET=
# set. The home's public IPv4 address, e.g. 203.0.113.7. coturn advertises it for relays and
# denies it as a peer (so nobody can be relayed to the router through the public address).
TURN_PUBLIC_IP=
# set. This Pi's LAN IPv4, e.g. 192.168.1.20. coturn's ports are published on this address only
# (the router forwards to it). Relays themselves live on coturn's own Docker network, IPv4 only.
TURN_RELAY_IP=
# Leave commented out until all of these are done: the rate limits (#35) are live, the DNS record
# turn.securevideocall.com exists, the router forwards are set, and secure-call#47 is live. The
# backend hands out TURN credentials as soon as this is set, so copying the example must not
# switch TURN on. Then uncomment it (see README.md "TURN").
# TURN_URLS=turn:turn.securevideocall.com:3478?transport=udp,turn:turn.securevideocall.com:3478?transport=tcp
