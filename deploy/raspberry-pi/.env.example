# Copy to .env (never commit .env) and fill in. docker compose reads it for PostgreSQL; the
# backend reads the same variables from its environment (export them, or use systemd's
# EnvironmentFile=).

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=securecall
POSTGRES_USER=securecall
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Same machine, so plain TCP to 127.0.0.1 is fine. Use "require" if the database ever moves
# to another machine.
POSTGRES_SSLMODE=prefer

# Backend
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=signal-test.example.com
SIGNALING_ALLOWED_ORIGINS=https://call.example.com
