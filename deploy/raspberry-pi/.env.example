# Copy to .env (never commit .env) and fill in the values marked "set". docker compose reads it,
# and passes it to the backend container.

# Docker network of Nginx Proxy Manager. Find it with:  docker network ls
# (often something like "nginx-proxy-manager_default" or "npm_default").  set
NPM_NETWORK=

# Backend
# set. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=signal.securevideocall.com
SIGNALING_ALLOWED_ORIGINS=https://securevideocall.com

# PostgreSQL
POSTGRES_DB=securecall
POSTGRES_USER=securecall
# set. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# The backend reaches the database as "postgres" on the internal Docker network
# (POSTGRES_HOST is set in compose.yaml). No database port is published on the Pi.
